spring.application.name=VideoConverter

# 监听端口

# 监听端口
server.port=8080

# 文件处理相关
## 文件上传下载配置，必须以/结尾（表示路径），且必须为绝对路径，最好不要使用反斜杠区分路径，以下是一个示例。
## file.upload-dir=D:/MyProject/Sakura_Anime/storgeFiles/
## 默认配置为Docker共享路径
file.upload-dir=/shared/
## 前缀，决定子目录和转码文件夹的开头如何
file.prefix=anime

# FFMPEG转码配置
## 单个切片时长(秒)
ffmpeg.hls.time=30
## 视频最大码率
ffmpeg.video.maxrate=5000
## 视频平均码率（VBR模式)
ffmpeg.video.avgrate=3000
## 是否开启N卡加速编码（默认开启，转码遇到问题请关闭）
ffmpeg.video.enableNvenc=true
## FFMPEG程序路径，若已经配好环境变量，则不需要改动
ffmpeg.locate="ffmpeg"
## FFMPEG的转码线程数，默认0为自动，会占用全部CPU/GPU，要多少线程就写多少，不能超过硬件限制
ffmpeg.threads=0

# HTTP单次上传的最大请求大小，为了传视频弄大点。
spring.servlet.multipart.max-file-size=10GB
spring.servlet.multipart.max-request-size=10GB

# 【安全设置】
## 是否启用设置回显，启用后可获得配置文件内容，请勿在生产环境启用
program.enable-echo-config=false
## 程序访问Token，请自行使用足够长的随机字符
program.programToken=This_Is_Test_Token_Please_Replace_It_With_Strong_Random_String
## 是否启用UserAgent检查器
program.useragent.enableChecker=true
### UserAgent检测黑白名单，留空则不检测，填写全匹配型正则表达式
### 预制黑名单：(?i)^.*(python-requests|curl|wget|Apache-HttpClient|Scrapy|bot|spider|crawler).*
program.useragent.blacklist=(?i)^.*(python-requests|curl|wget|Apache-HttpClient|Scrapy|bot|spider|crawler).*
### UserAgent检测白名单
### 预制白名单：^(Mozilla|Chrome|Safari|Edge|Opera|Gecko|PostmanRuntime|VLC).*$
program.useragent.whitelist=

## swagger 文档
springdoc.api-docs.enabled=false
springdoc.swagger-ui.enabled=false
## Spring DevTools 热重启配置
spring.devtools.restart.enabled=false
## Spring DevTools 热部署
spring.devtools.add-properties=false
